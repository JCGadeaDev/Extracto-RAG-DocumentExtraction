# Copia este archivo a .env y rellena tu clave (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Opcional: modelo con visión a usar
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Solo para npm run dev (Docker Compose ya las define): base de datos y usuario de solo
# lectura con el que el chat ejecuta las consultas SQL que genera
# DATABASE_URL=postgres://extracto:extracto@localhost:5432/extracto
# DATABASE_URL_LECTURA=postgres://extracto_lector:extracto_lector@localhost:5432/extracto
